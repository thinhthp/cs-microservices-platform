  "ReverseProxy": {
    "Routes": {
      "ProductService": {
        "ClusterId": "ProductServiceCluster",
        "Match": { "Path": "/api/products/{**catchall}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/products" },
          { "RequestHeaderOriginalHost": true },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "InventoryService": {
        "ClusterId": "InventoryServiceCluster",
        "Match": { "Path": "/api/inventory/{**catchall}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/inventory" },
          { "RequestHeaderOriginalHost": true },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "SalesService": {
        "ClusterId": "SalesServiceCluster",
        "Match": { "Path": "/api/sales/{**catchall}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/sales" },
          { "RequestHeaderOriginalHost": true },
          { "RequestHeaderRemove": "Authorization" }
        ]
      }
    },
    "Clusters": {
      "ProductServiceCluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7101/" }
        }
      },
      "InventoryServiceCluster": {
        "Destinations": {
